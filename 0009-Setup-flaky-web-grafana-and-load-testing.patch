+# Lets the kube-prometheus-stack Prometheus (scripts/grafana-up.sh) scrape flaky-web. Needs that stack's CRDs, so it
+# is applied only together with the dashboard (kustomization.yaml).
+apiVersion: monitoring.coreos.com/v1
+kind: ServiceMonitor
+metadata:
+  name: flaky-web
+  namespace: default
+  labels:
+    app: flaky-web
+    release: kube-prometheus-stack  # the Prometheus only selects ServiceMonitors with this label
+spec:
+  selector: {matchLabels: {app: flaky-web}}
+  endpoints:
+    - {port: http, path: /metrics, interval: 15s}
