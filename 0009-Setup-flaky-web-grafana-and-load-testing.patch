diff --git a/k8s/grafana/grafana-mcp.yaml b/k8s/grafana/grafana-mcp.yaml
new file mode 100644
index 0000000..3e6556a
--- /dev/null
+++ b/k8s/grafana/grafana-mcp.yaml
@@ -0,0 +1,10 @@
+# mcp-grafana, read-only, over streamable HTTP on :8000/mcp. Reached through `kubectl port-forward`,
+# so the Host header is 127.0.0.1:<random port>: Host validation is off. No anonymous usage stats.
+grafana:
+  url: http://grafana:80
+env:
+  GRAFANA_USERNAME: admin
+  GRAFANA_PASSWORD: admin
+disableWrite: true
+command: [/app/mcp-grafana]
+extraArgs: [--transport=streamable-http, --address=0.0.0.0:8000, --allowed-hosts=*, --usage-stats=disabled]
diff --git a/k8s/grafana/kube-prometheus-stack.yaml b/k8s/grafana/kube-prometheus-stack.yaml
new file mode 100644
index 0000000..87881e4
--- /dev/null
+++ b/k8s/grafana/kube-prometheus-stack.yaml
@@ -0,0 +1,34 @@
+# Prometheus (+ kube-state-metrics for pod restarts, OOM kills, image pull errors) and Grafana, sized for kind.
+# Components kind doesn't expose or the triage doesn't need are off.
+alertmanager: {enabled: false}
+nodeExporter: {enabled: false}
+kubeEtcd: {enabled: false}
+kubeScheduler: {enabled: false}
+kubeControllerManager: {enabled: false}
+kubeProxy: {enabled: false}
+defaultRules: {create: false}
+# The admission webhooks only validate PrometheusRules etc.; their pre-install hook jobs hang under Helm 4
+# (it waits for the deletion of a hook ServiceAccount that doesn't exist).
+prometheusOperator:
+  admissionWebhooks: {enabled: false}
+  tls: {enabled: false}  # its certificate came from those hook jobs
+
+prometheus:
+  prometheusSpec:
+    scrapeInterval: 15s
+    retention: 1d
+
+grafana:
+  fullnameOverride: grafana
+  adminUser: admin
+  adminPassword: admin
+  defaultDashboardsTimezone: utc
+  sidecar:
+    datasources:
+      uid: prometheus  # stable UIDs, so MCP queries can name the datasource
+  additionalDataSources:
+    - name: Loki
+      uid: loki
+      type: loki
+      access: proxy
+      url: http://loki:3100
diff --git a/k8s/grafana/loki.yaml b/k8s/grafana/loki.yaml
new file mode 100644
index 0000000..ce0eef5
--- /dev/null
+++ b/k8s/grafana/loki.yaml
@@ -0,0 +1,23 @@
+# Loki as a single binary on the local filesystem.
+deploymentMode: Monolithic
+loki:
+  auth_enabled: false
+  commonConfig: {replication_factor: 1}
+  storage: {type: filesystem}
+  schemaConfig:
+    configs:
+      - from: "2024-04-01"
+        store: tsdb
+        object_store: filesystem
+        schema: v13
+        index: {prefix: loki_index_, period: 24h}
+singleBinary: {replicas: 1}
+# the chart also defaults the simple-scalable targets to replicas > 0; monolithic needs them off
+read: {replicas: 0}
+write: {replicas: 0}
+backend: {replicas: 0}
+gateway: {enabled: false}
+chunksCache: {enabled: false}
+resultsCache: {enabled: false}
+lokiCanary: {enabled: false}
+test: {enabled: false}
diff --git a/scripts/flaky-web-up.sh b/scripts/flaky-web-up.sh
new file mode 100755
index 0000000..5888bcb
--- /dev/null
+++ b/scripts/flaky-web-up.sh
@@ -0,0 +1,61 @@
+#!/bin/sh
+# Deploy flaky-web (random timeouts, Prometheus metrics) into the kind cluster from scripts/cluster-up.sh, from the
+# local Docker image flaky-web:dev, which must be built first:
+#
+#   docker build -t flaky-web:dev ../flaky-web
+#
+# When the Grafana stack from scripts/grafana-up.sh is up, also deploys its ServiceMonitor and Grafana dashboard
+# (Dashboards -> flaky-web); otherwise just the app. Rerun after rebuilding the image or installing the Grafana stack.
+#
+#   scripts/flaky-web-up.sh
+#   KIND_DEV_CLUSTER_NAME=my-cluster KIND_DEV_KUBECONFIG=/tmp/my.kubeconfig scripts/flaky-web-up.sh
+#
+# Then:
+#   kubectl --kubeconfig .cache/kind-dev.kubeconfig port-forward svc/flaky-web 8080
+set -eu
+set -x
+cd "$(dirname "$0")/.."
+
+CLUSTER=${KIND_DEV_CLUSTER_NAME:-k8-triage-dev}
+export KUBECONFIG=${KIND_DEV_KUBECONFIG:-$PWD/.cache/kind-dev.kubeconfig}
+IMAGE=flaky-web:dev
+
+for tool in docker kind kubectl; do
+  command -v "$tool" >/dev/null || { echo "error: $tool is not installed" >&2; exit 1; }
+done
+if ! kubectl cluster-info >/dev/null 2>&1; then
+  echo "error: no cluster at $KUBECONFIG; run scripts/cluster-up.sh first" >&2
+  exit 1
+fi
+if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
+  echo "error: no Docker image $IMAGE; build it first: docker build -t $IMAGE ../flaky-web" >&2
+  exit 1
+fi
+
+# Not `kind load docker-image`: with Docker's containerd image store it can fail on layers of other platforms
+# (see scripts/grafana-up.sh). The Deployment never pulls (imagePullPolicy: Never), so the image must be on the node.
+echo "==> Loading $IMAGE into kind"
+platform=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$IMAGE")
+for node in $(kind get nodes --name "$CLUSTER"); do
+  docker save --platform "$platform" "$IMAGE" \
+    | docker exec -i "$node" ctr --namespace=k8s.io images import --digests --snapshotter=overlayfs - >/dev/null
+done
+
+existed=$(kubectl get deployment flaky-web -o name --ignore-not-found)
+if kubectl -n monitoring get deployment grafana >/dev/null 2>&1; then
+  echo "==> Deploying flaky-web with its ServiceMonitor and Grafana dashboard"
+  kubectl apply -k scripts/flaky-web
+else
+  echo "==> Deploying flaky-web (no Grafana stack: skipping its ServiceMonitor and dashboard)"
+  kubectl apply -f scripts/flaky-web/k8s.yaml
+fi
+# Same image tag, so a rebuilt image only reaches an existing Deployment through a restart.
+if [ -n "$existed" ]; then
+  kubectl rollout restart deployment/flaky-web
+fi
+kubectl rollout status deployment/flaky-web --timeout=120s
+
+kubectl get deployment,pods -l app=flaky-web
+echo
+echo "Ready. Kubeconfig: $KUBECONFIG"
+echo "  kubectl --kubeconfig $KUBECONFIG port-forward svc/flaky-web 8080   # http://localhost:8080"
