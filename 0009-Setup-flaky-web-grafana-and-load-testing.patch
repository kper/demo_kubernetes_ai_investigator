@@ -0,0 +1,13 @@
+# flaky-web plus its ServiceMonitor and Grafana dashboard, once the Grafana stack is up: kubectl apply -k scripts/flaky-web
+# The dashboard ConfigMap carries the label Grafana's sidecar watches (any namespace), so it shows up in Grafana
+# under Dashboards -> flaky-web without importing anything. Edit it in Grafana, export the JSON into dashboard.json.
+resources:
+  - k8s.yaml
+  - monitoring.yaml
+configMapGenerator:
+  - name: flaky-web-dashboard
+    namespace: default
+    files: [dashboard.json]
+    options:
+      disableNameSuffixHash: true
+      labels: {grafana_dashboard: "1"}
