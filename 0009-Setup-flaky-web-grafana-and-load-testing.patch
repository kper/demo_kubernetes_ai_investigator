@@ -0,0 +1,8 @@
+# scripts/load-test.sh with ApacheBench. Build from the repo root, so the script is in the build context:
+#
+#   docker build -t load-test:dev -f scripts/load-test/Dockerfile .   (or just scripts/load-test.sh, without a URL)
+FROM alpine:3.22
+RUN apk add --no-cache apache2-utils
+COPY scripts/load-test.sh /usr/local/bin/load-test
+USER 65534
+ENTRYPOINT ["load-test"]
diff --git a/scripts/load-test/job.yaml b/scripts/load-test/job.yaml
new file mode 100644
index 0000000..d4381b8
--- /dev/null
+++ b/scripts/load-test/job.yaml
@@ -0,0 +1,28 @@
+# Runs scripts/load-test.sh (ab) once against flaky-web from inside the cluster. generateName gives every run its
+# own Job, so it is created, not applied (apply doesn't support generateName). Build, load and run it with
+# scripts/load-test.sh (without a URL).
+apiVersion: batch/v1
+kind: Job
+metadata:
+  generateName: load-test-
+  namespace: default
+  labels: {app: load-test}
+spec:
+  backoffLimit: 0  # a load test that failed shouldn't silently run again
+  ttlSecondsAfterFinished: 3600
+  template:
+    metadata: {labels: {app: load-test}}
+    spec:
+      restartPolicy: Never
+      containers:
+        - name: load-test
+          image: load-test:dev
+          imagePullPolicy: Never  # loaded into kind, not in a registry
+          args: ["http://flaky-web:8080/"]
+          env:
+            - {name: REQUESTS, value: "500"}
+            - {name: CONCURRENCY, value: "20"}
+            - {name: TIMEOUT, value: "60"}  # above flaky-web's 30s hang, or ab aborts the run
+          resources:
+            requests: {cpu: 50m, memory: 16Mi}
+            limits: {memory: 64Mi}
