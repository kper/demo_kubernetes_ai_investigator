diff --git a/scripts/flaky-web/k8s.yaml b/scripts/flaky-web/k8s.yaml
new file mode 100644
index 0000000..2f60997
--- /dev/null
+++ b/scripts/flaky-web/k8s.yaml
@@ -0,0 +1,40 @@
+# flaky-web in the default namespace. The image is built locally and loaded into kind: scripts/flaky-web-up.sh.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: flaky-web
+  namespace: default
+  labels: {app: flaky-web}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: flaky-web}}
+  template:
+    metadata: {labels: {app: flaky-web}}
+    spec:
+      containers:
+        - name: flaky-web
+          image: flaky-web
+          imagePullPolicy: Never  # loaded into kind, not in a registry
+          env:
+            - {name: TIMEOUT_RATE, value: "0.2"}
+            - {name: TIMEOUT_SECONDS, value: "30"}
+          ports:
+            - {name: http, containerPort: 8080}
+          readinessProbe:
+            httpGet: {path: /healthz, port: http}
+          livenessProbe:
+            httpGet: {path: /healthz, port: http}
+          resources:
+            requests: {cpu: 10m, memory: 16Mi}
+            limits: {memory: 64Mi}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: flaky-web
+  namespace: default
+  labels: {app: flaky-web}
+spec:
+  selector: {app: flaky-web}
+  ports:
+    - {name: http, port: 8080, targetPort: http}
