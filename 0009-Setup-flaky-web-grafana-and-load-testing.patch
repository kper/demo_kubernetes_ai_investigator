--- /dev/null
+++ b/scripts/grafana-down.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+# Uninstall the Grafana stack installed by scripts/grafana-up.sh and delete its namespace. The cluster keeps running.
+#
+#   scripts/grafana-down.sh
+#   KIND_DEV_KUBECONFIG=/tmp/my.kubeconfig scripts/grafana-down.sh
+set -eu
+set -x
+cd "$(dirname "$0")/.."
+
+export KUBECONFIG=${KIND_DEV_KUBECONFIG:-$PWD/.cache/kind-dev.kubeconfig}
+NAMESPACE=monitoring
+
+while read -r release repo version; do
+  case $release in ""|\#*) continue ;; esac
+  # No --wait: under Helm 4 it hung on kube-prometheus-stack after everything was deleted. Deleting the namespace
+  # below blocks until all of its resources are gone instead.
+  helm uninstall "$release" --namespace "$NAMESPACE" --ignore-not-found
+done < k8s/grafana/charts.txt
+kubectl delete namespace "$NAMESPACE" --ignore-not-found --timeout=5m
+# Created by the Prometheus operator, not Helm, so the uninstall leaves it behind.
+kubectl -n kube-system delete service kube-prometheus-stack-kubelet --ignore-not-found
+# kube-prometheus-stack leaves its CRDs (Prometheus, ServiceMonitor, ...) installed; they are harmless and reused.
+echo "Deleted the Grafana stack (namespace $NAMESPACE)"
diff --git a/scripts/grafana-up.sh b/scripts/grafana-up.sh
new file mode 100755
index 0000000..6de4c85
--- /dev/null
+++ b/scripts/grafana-up.sh
@@ -0,0 +1,77 @@
+#!/bin/sh
+# Install the Grafana stack into the kind cluster from scripts/cluster-up.sh, in namespace monitoring (kept apart from
+# the workloads the agent triages): Prometheus with kube-state-metrics, Loki with Alloy shipping every pod's logs, Grafana
+# with both as datasources, and mcp-grafana (read-only). Charts and values: k8s/grafana.
+# Upgrades the releases if they are already installed. Remove them with scripts/grafana-down.sh.
+#
+#   scripts/grafana-up.sh
+#   KIND_DEV_CLUSTER_NAME=my-cluster KIND_DEV_KUBECONFIG=/tmp/my.kubeconfig scripts/grafana-up.sh
+#
+# Then:
+#   kubectl --kubeconfig .cache/kind-dev.kubeconfig -n monitoring port-forward svc/grafana 3000:80    # admin/admin
+#   kubectl --kubeconfig .cache/kind-dev.kubeconfig -n monitoring port-forward svc/grafana-mcp 8000   # /mcp
+set -eu
+set -x
+cd "$(dirname "$0")/.."
+
+CLUSTER=${KIND_DEV_CLUSTER_NAME:-k8-triage-dev}
+export KUBECONFIG=${KIND_DEV_KUBECONFIG:-$PWD/.cache/kind-dev.kubeconfig}
+NAMESPACE=monitoring
+
+for tool in docker kind kubectl helm; do
+  command -v "$tool" >/dev/null || { echo "error: $tool is not installed" >&2; exit 1; }
+done
+if ! kubectl cluster-info >/dev/null 2>&1; then
+  echo "error: no cluster at $KUBECONFIG; run scripts/cluster-up.sh first" >&2
+  exit 1
+fi
+
+# The kind node pulls one image at a time and starts from an empty cache with every new cluster, so the Grafana and
+# Prometheus images alone took 10+ minutes. Load them from the local Docker cache instead (pulled there once).
+# Left out: images pinned by digest (kind load can't satisfy those; the kubelet pulls them), bats (helm test only)
+# and thanos (only with Thanos enabled).
+echo "==> Loading the stack's images into kind from the local Docker cache"
+images=$(
+  while read -r release repo version; do
+    case $release in ""|\#*) continue ;; esac
+    helm template "$release" "$release" --repo "$repo" --version "$version" \
+      --namespace "$NAMESPACE" --values "k8s/grafana/$release.yaml"
+  done < k8s/grafana/charts.txt \
+    | grep -oE '(image: *"?|=)(docker\.io|quay\.io|ghcr\.io|registry\.k8s\.io)/[^" ,]+' \
+    | sed -E 's/^(image: *"?|=)//' \
+    | grep -vE '@|/bats/|/thanos/' \
+    | sort -u
+)
+# Not `kind load docker-image`: with Docker's containerd image store, `docker save` writes the multi-platform index but
+# only this platform's layers, and kind's `ctr import --all-platforms` fails on the missing ones
+# ("content digest sha256:...: not found"). So save just this platform and import that the way kind does.
+platform=$(docker version --format '{{.Server.Os}}/{{.Server.Arch}}')
+for image in $images; do
+  docker image inspect "$image" >/dev/null 2>&1 || docker pull -q --platform "$platform" "$image"
+  for node in $(kind get nodes --name "$CLUSTER"); do
+    docker save --platform "$platform" "$image" \
+      | docker exec -i "$node" ctr --namespace=k8s.io images import --digests --snapshotter=overlayfs - >/dev/null
+  done
+done
+
+echo "==> Installing the Grafana stack into namespace $NAMESPACE (a few minutes)"
+pids=""
+while read -r release repo version; do
+  case $release in ""|\#*) continue ;; esac
+  helm upgrade --install "$release" "$release" --repo "$repo" --version "$version" \
+    --namespace "$NAMESPACE" --create-namespace \
+    --values "k8s/grafana/$release.yaml" --wait --timeout 10m &
+  pids="$pids $!"
+done < k8s/grafana/charts.txt
+failed=0
+for pid in $pids; do wait "$pid" || failed=1; done
+if [ "$failed" -ne 0 ]; then
+  echo "error: a Helm install failed (see above)" >&2
+  exit 1
+fi
+
+kubectl -n "$NAMESPACE" get deployments,statefulsets,pods
+echo
+echo "Ready. Kubeconfig: $KUBECONFIG"
+echo "  kubectl --kubeconfig $KUBECONFIG -n $NAMESPACE port-forward svc/grafana 3000:80    # http://localhost:3000, admin/admin"
+echo "  kubectl --kubeconfig $KUBECONFIG -n $NAMESPACE port-forward svc/grafana-mcp 8000   # http://127.0.0.1:8000/mcp"
diff --git a/scripts/load-test.sh b/scripts/load-test.sh
new file mode 100755
index 0000000..c01494a
--- /dev/null
+++ b/scripts/load-test.sh
@@ -0,0 +1,109 @@
+#!/bin/sh
+# Load test with ApacheBench (ab), in one of two ways:
+#
+# - With a URL: REQUESTS GETs to URL, CONCURRENCY at a time, then a summary of status codes, throughput and latency
+#   percentiles. Uses a local `ab` (apt install apache2-utils), else the one in the httpd Docker image. For flaky-web,
+#   forward its port first: kubectl --kubeconfig .cache/kind-dev.kubeconfig port-forward svc/flaky-web 8080
+#
+#     scripts/load-test.sh http://localhost:8080/                       # 200 requests, 10 at a time
+#     REQUESTS=1000 CONCURRENCY=50 scripts/load-test.sh http://localhost:8080/
+#
+# - Without a URL: against flaky-web (scripts/flaky-web-up.sh) from inside the kind cluster. Builds this script into
+#   the load-test image (scripts/load-test/Dockerfile), loads it into kind, starts a new Job (scripts/load-test/job.yaml,
+#   which runs this script with flaky-web's URL) and follows its output until it ends. REQUESTS, CONCURRENCY and
+#   TIMEOUT override the Job's defaults (500, 20, 60s). Finished Jobs are deleted after an hour.
+#
+#     scripts/load-test.sh
+#     REQUESTS=2000 CONCURRENCY=50 scripts/load-test.sh
+#     KIND_DEV_CLUSTER_NAME=my-cluster KIND_DEV_KUBECONFIG=/tmp/my.kubeconfig scripts/load-test.sh
+#
+# ab aborts the whole run when a request exceeds its timeout, so TIMEOUT must be longer than the server's slowest
+# answer (flaky-web: TIMEOUT_SECONDS, default 30). Hanging requests then show up as non-2xx (504) and in the latency tail.
+set -eu
+
+run_ab() {
+  url=$1
+  requests=${REQUESTS:-200}
+  concurrency=${CONCURRENCY:-10}
+  timeout=${TIMEOUT:-60}  # seconds ab waits for a response before aborting the run
+
+  if command -v ab >/dev/null; then
+    set -- ab
+  elif command -v docker >/dev/null; then
+    set -- docker run --rm --network host httpd:2.4-alpine ab  # host network: localhost is this machine
+  else
+    echo "error: needs ab (apt install apache2-utils) or docker" >&2
+    exit 1
+  fi
+
+  echo "Load testing $url: $requests requests, $concurrency concurrent, ${timeout}s timeout"
+  # -l: don't count a different body length (the 504's) as a failed request; -r: don't stop on socket errors
+  status=0
+  output=$("$@" -n "$requests" -c "$concurrency" -s "$timeout" -l -r "$url" 2>&1) || status=$?
+  printf '%s\n' "$output" | grep -E \
+    'Complete requests|Failed requests|Non-2xx responses|Time taken|Requests per second|Time per request:.*\(mean\)|^ +(50|90|95|99|100)%|apr_|requests completed' \
+    || printf '%s\n' "$output"
+  if [ "$status" -ne 0 ]; then
+    echo "error: ab aborted (exit $status); if a request timed out, raise TIMEOUT above the server's slowest answer" >&2
+  fi
+  exit "$status"
+}
+
+run_job() {
+  set -x
+  cd "$(dirname "$0")/.."
+  cluster=${KIND_DEV_CLUSTER_NAME:-k8-triage-dev}
+  export KUBECONFIG=${KIND_DEV_KUBECONFIG:-$PWD/.cache/kind-dev.kubeconfig}
+  image=load-test:dev
+
+  for tool in docker kind kubectl; do
+    command -v "$tool" >/dev/null || { echo "error: $tool is not installed" >&2; exit 1; }
+  done
+  if ! kubectl cluster-info >/dev/null 2>&1; then
+    echo "error: no cluster at $KUBECONFIG; run scripts/cluster-up.sh first" >&2
+    exit 1
+  fi
+  if ! kubectl get deployment flaky-web >/dev/null 2>&1; then
+    echo "error: flaky-web is not deployed; run scripts/flaky-web-up.sh first" >&2
+    exit 1
+  fi
+
+  echo "==> Building $image and loading it into kind"
+  docker build -q -t "$image" -f scripts/load-test/Dockerfile .
+  # Not `kind load docker-image`: with Docker's containerd image store it can fail on layers of other platforms
+  # (see scripts/grafana-up.sh).
+  platform=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$image")
+  for node in $(kind get nodes --name "$cluster"); do
+    docker save --platform "$platform" "$image" \
+      | docker exec -i "$node" ctr --namespace=k8s.io images import --digests --snapshotter=overlayfs - >/dev/null
+  done
+
+  echo "==> Starting the load test"
+  overrides=""
+  for name in REQUESTS CONCURRENCY TIMEOUT; do
+    eval "value=\${$name:-}"
+    [ -n "$value" ] && overrides="$overrides $name=$value"
+  done
+  if [ -n "$overrides" ]; then
+    # shellcheck disable=SC2086 # one argument per override
+    job=$(kubectl set env --local -f scripts/load-test/job.yaml $overrides -o yaml | kubectl create -f - -o name)
+  else
+    job=$(kubectl create -f scripts/load-test/job.yaml -o name)
+  fi
+  kubectl wait --for=condition=ready pod -l "batch.kubernetes.io/job-name=${job#*/}" --timeout=120s
+  kubectl logs -f "$job"
+
+  # The pod's exit code (ab's) decides whether the Job completed or failed.
+  if kubectl wait --for=condition=complete "$job" --timeout=30s >/dev/null 2>&1; then
+    echo "Load test $job completed"
+  else
+    echo "error: load test $job failed: kubectl describe $job" >&2
+    exit 1
+  fi
+}
+
+if [ $# -gt 0 ]; then
+  run_ab "$1"
+else
+  run_job
+fi
diff --git a/scripts/load-test/Dockerfile b/scripts/load-test/Dockerfile
