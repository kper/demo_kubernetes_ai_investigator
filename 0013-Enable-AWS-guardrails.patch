diff --git a/src/main/java/com/ebcont/k8/triage/GuardrailBlock.java b/src/main/java/com/ebcont/k8/triage/GuardrailBlock.java
new file mode 100644
index 0000000..740d11c
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/GuardrailBlock.java
@@ -0,0 +1,48 @@
+package com.ebcont.k8.triage;
+
+import com.fasterxml.jackson.annotation.JsonPropertyDescription;
+import tools.jackson.core.JacksonException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.util.Optional;
+
+/**
+ * A Bedrock guardrail block (BedrockGuardrailInterceptor). When the guardrail blocks a call, Bedrock returns the
+ * guardrail's configured message instead of the model's reply. That message is a root cause report without findings
+ * that marks the block, so every agent can recognise it:
+ * {@code {"findings":[],"blocked":{"by":"guardrail","stage":"input","message":"..."}}} (stage "input" or "output").
+ */
+public record GuardrailBlock(
+        @JsonPropertyDescription("Always \"guardrail\"")
+        String by,
+        @JsonPropertyDescription("\"input\" if the request was blocked, \"output\" if the model's answer was")
+        String stage,
+        @JsonPropertyDescription("Why it was blocked")
+        String message) {
+
+    /** The block in a model reply that is the guardrail's message, or empty for a normal reply. */
+    public static Optional<GuardrailBlock> in(String reply) {
+        if (reply == null || !reply.contains("\"blocked\"")) {
+            return Optional.empty();
+        }
+        try {
+            JsonNode blocked = JsonMapper.shared().readTree(reply.trim()).path("blocked");
+            if (!"guardrail".equals(blocked.path("by").asString(""))) {
+                return Optional.empty();
+            }
+            return Optional.of(new GuardrailBlock("guardrail", blocked.path("stage").asString(""),
+                    blocked.path("message").asString("")));
+        } catch (JacksonException e) {
+            return Optional.empty();
+        }
+    }
+
+    /** Thrown by an agent whose call the guardrail blocked; the step's result would be meaningless. */
+    public static class BlockedException extends RuntimeException {
+
+        public BlockedException(String agent, GuardrailBlock block) {
+            super("Bedrock guardrail blocked the " + agent + " (" + block.stage() + "): " + block.message());
+        }
+    }
+}
