--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/RootCauseAgent.java
@@ -0,0 +1,38 @@
+package com.ebcont.k8.triage;
+
+import org.springframework.ai.chat.client.ChatClient;
+import org.springframework.stereotype.Component;
+
+import java.util.List;
+
+@Component
+public class RootCauseAgent {
+    public static String ROOT_CAUSE_PROMPT = """
+            You are a root cause analysis agent. You receive all evidence an investigator
+            collected from Kubernetes. Using only that evidence, write a short report: for each
+            unhealthy workload, give the symptom, the root cause with the evidence that proves it,
+            and a concrete fix. Say so if the evidence is insufficient.
+            """;
+
+    private static final String ROLLBACK_INSTRUCTIONS = """
+            For each finding, propose a rollback: pick the last revision in the deployment's rollout history that
+            ran without the offending change. Only recommend it if rolling back to that revision fixes the symptom.
+            """;
+
+    private final ChatClient chatClient;
+
+    public RootCauseAgent(ChatClient.Builder builder) {
+        this.chatClient = builder
+                .defaultSystem(ROOT_CAUSE_PROMPT + ROLLBACK_INSTRUCTIONS)
+                .build();
+    }
+
+    public RootCauseReport analyse(List<String> toolEvidence, String investigatorAnswer) {
+        String evidence = toolEvidence.isEmpty() ? "(no tool calls)" : String.join("\n\n", toolEvidence);
+        return chatClient.prompt()
+                .user("## Tool calls and their output\n\n" + evidence
+                        + "\n\n## Investigator's final message\n\n" + investigatorAnswer)
+                .call()
+                .entity(RootCauseReport.class);
+    }
+}
diff --git a/src/main/java/com/ebcont/k8/triage/RootCauseReport.java b/src/main/java/com/ebcont/k8/triage/RootCauseReport.java
new file mode 100644
index 0000000..c1cc956
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/RootCauseReport.java
@@ -0,0 +1,66 @@
+package com.ebcont.k8.triage;
+
+import com.fasterxml.jackson.annotation.JsonPropertyDescription;
+
+import java.util.List;
+
+/** Structured output of the {@link RootCauseAgent}: one finding per unhealthy workload. */
+public record RootCauseReport(
+        @JsonPropertyDescription("One entry per unhealthy workload")
+        List<Finding> findings) {
+
+    public record Finding(
+            @JsonPropertyDescription("Namespace of the workload")
+            String namespace,
+            @JsonPropertyDescription("Deployment name")
+            String deployment,
+            @JsonPropertyDescription("Observed symptom, e.g. CrashLoopBackOff with the error from the logs")
+            String symptom,
+            @JsonPropertyDescription("Root cause, based only on the evidence")
+            String rootCause,
+            @JsonPropertyDescription("The change that introduced the problem")
+            OffendingChange offendingChange,
+            @JsonPropertyDescription("Quotes from the evidence (logs, events, rollout history) that prove the root cause")
+            List<String> evidence,
+            @JsonPropertyDescription("Concrete fix for the underlying problem")
+            String fix,
+            @JsonPropertyDescription("Proposed rollback; set recommended=false if a rollback would not help")
+            RollbackProposal rollback,
+            @JsonPropertyDescription("False if the evidence is insufficient to be confident about the root cause")
+            boolean evidenceSufficient) {
+    }
+
+    public record OffendingChange(
+            @JsonPropertyDescription("Where the change came from")
+            ChangeSource source,
+            @JsonPropertyDescription("Commit SHA for GitHub deployments, otherwise null")
+            String commit,
+            @JsonPropertyDescription("Author or user who made the change, if known")
+            String author,
+            @JsonPropertyDescription("Deployment revision that introduced the change")
+            Integer revision,
+            @JsonPropertyDescription("Change-cause annotation or other description of the change")
+            String description) {
+    }
+
+    public enum ChangeSource { GITHUB, MANUAL, UNKNOWN }
+
+    public record RollbackProposal(
+            @JsonPropertyDescription("True if rolling back resolves the incident")
+            boolean recommended,
+            @JsonPropertyDescription("Last healthy deployment revision to roll back to (from the rollout history)")
+            Integer toRevision,
+            @JsonPropertyDescription("Why this revision is safe to roll back to, or why a rollback would not help")
+            String reason) {
+    }
+
+    /** The `kubectl rollout undo` command for a recommended rollback, or null. */
+    public static String rollbackCommand(Finding finding) {
+        RollbackProposal rollback = finding.rollback();
+        if (rollback == null || !rollback.recommended() || rollback.toRevision() == null) {
+            return null;
+        }
+        return "kubectl rollout undo deployment/" + finding.deployment() + " -n " + finding.namespace()
+                + " --to-revision=" + rollback.toRevision();
+    }
+}
diff --git a/src/main/java/com/ebcont/k8/triage/TriageRunner.java b/src/main/java/com/ebcont/k8/triage/TriageRunner.java
index da80f20..df998d6 100644
--- a/src/main/java/com/ebcont/k8/triage/TriageRunner.java
+++ b/src/main/java/com/ebcont/k8/triage/TriageRunner.java
@@ -16,16 +16,47 @@ public class TriageRunner implements CommandLineRunner {
     private static final Logger log = LoggerFactory.getLogger(TriageRunner.class);
 
     private final InvestigatorAgent investigator;
+    private final RootCauseAgent rootCause;
+    private final KubernetesDiagnosticTools diagnosticTools;
     private final List<String> namespaces;
 
-    public TriageRunner(InvestigatorAgent investigator, @Value("${triage.namespaces}") List<String> namespaces) {
+    public TriageRunner(InvestigatorAgent investigator, RootCauseAgent rootCause,
+                        KubernetesDiagnosticTools diagnosticTools,
+                        @Value("${triage.namespaces}") List<String> namespaces) {
         this.investigator = investigator;
+        this.rootCause = rootCause;
+        this.diagnosticTools = diagnosticTools;
         this.namespaces = namespaces;
     }
 
     @Override
     public void run(String... args) {
         log.info("Starting investigation of namespaces {}", namespaces);
-        log.info("Investigator: {}", investigator.investigate(namespaces));
+        diagnosticTools.clearEvidence();
+        String investigation = investigator.investigate(namespaces);
+        log.info("Investigator: {}", investigation);
+
+        List<String> evidence = diagnosticTools.evidence();
+        log.info("Running root cause analysis on {} tool results", evidence.size());
+        RootCauseReport report = rootCause.analyse(evidence, investigation);
+        for (RootCauseReport.Finding finding : report.findings()) {
+            log.info("""
+                            {}/{}
+                              Symptom:    {}
+                              Root cause: {}
+                              Change:     {}
+                              Evidence:   {}
+                              Fix:        {}
+                              Rollback:   {}""",
+                    finding.namespace(), finding.deployment(), finding.symptom(), finding.rootCause(),
+                    finding.offendingChange(), finding.evidence(), finding.fix(), formatRollback(finding));
+        }
+    }
+
+    private static String formatRollback(RootCauseReport.Finding finding) {
+        String command = RootCauseReport.rollbackCommand(finding);
+        String reason = finding.rollback() == null ? "" : " (" + finding.rollback().reason() + ")";
+        // Only proposed: nothing is rolled back automatically.
+        return (command != null ? "proposed: " + command : "not recommended") + reason;
     }
 }
