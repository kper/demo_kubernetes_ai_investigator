             You are a Kubernetes SRE collecting evidence about a cluster. Use the tools
             to find unhealthy pods and deployments. For every unhealthy workload, gather its pod details, logs
             and events, its Kubernetes deployment and rollout history.
+            A pod can be Running and Ready and still fail its users, for example with slow requests, timeouts or
+            5xx responses that its health check does not see. So always call scanPodLogs for every namespace, and
+            treat a workload whose logs show such errors as unhealthy.
+            Only report what the tool results show: never describe logs, events or metrics you did not fetch.
             Do not diagnose: a separate root cause agent will analyse everything you collect.
             When you have gathered enough evidence, reply with relevant findings.
             """;
 
     private static final String REVISION_ANNOTATION = "deployment.kubernetes.io/revision";
     private static final String CHANGE_CAUSE_ANNOTATION = "kubernetes.io/change-cause";
+    /** Log lines scanPodLogs reports: errors, timeouts and HTTP 5xx status codes (e.g. "GET / 504 30001ms"). */
+    private static final Pattern LOG_PROBLEM =
+            Pattern.compile("(?i)\\b(error|fatal|panic|exception|timeout|timed out)\\b|\\s5\\d\\d\\s");
+    private static final int LOG_PROBLEM_SAMPLES = 5;
     private static final String LAST_APPLIED_ANNOTATION = "kubectl.kubernetes.io/last-applied-configuration";
 
     private final KubernetesClient client;
@@ -160,6 +169,35 @@ public class KubernetesDiagnosticTools {
         });
     }
 
+    @Tool(description = "Scan the recent logs of every pod in a namespace, including Running and Ready ones, for errors, "
+            + "timeouts and 5xx responses that health checks don't see. Returns per pod how many lines match, with samples.")
+    public String scanPodLogs(@ToolParam(description = "Namespace to scan") String namespace) {
+        return call(() -> {
+            StringBuilder sb = new StringBuilder("POD/CONTAINER  MATCHING LINES (of last " + logTailLines + ")\n");
+            for (Pod pod : client.pods().inNamespace(namespace).list().getItems()) {
+                if ("Succeeded".equals(pod.getStatus().getPhase())) {
+                    continue;  // finished Job pods
+                }
+                for (Container container : pod.getSpec().getContainers()) {
+                    String name = pod.getMetadata().getName() + "/" + container.getName();
+                    List<String> lines;
+                    try {
+                        lines = orEmpty(client.pods().inNamespace(namespace).withName(pod.getMetadata().getName())
+                                .inContainer(container.getName()).tailingLines(logTailLines).getLog()).lines().toList();
+                    } catch (KubernetesClientException e) {
+                        String reason = e.getStatus() != null ? e.getStatus().getMessage() : e.getMessage();
+                        sb.append(name).append("  (no logs: ").append(reason).append(")\n");
+                        continue;
+                    }
+                    List<String> matches = lines.stream().filter(line -> LOG_PROBLEM.matcher(line).find()).toList();
+                    sb.append(name).append("  ").append(matches.size()).append('/').append(lines.size()).append('\n');
+                    matches.stream().limit(LOG_PROBLEM_SAMPLES).forEach(line -> sb.append("    ").append(line).append('\n'));
+                }
+            }
+            return sb.toString();
+        });
+    }
