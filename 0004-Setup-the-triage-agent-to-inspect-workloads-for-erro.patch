diff --git a/k8s/workloads/broken.yaml b/k8s/workloads/broken.yaml
new file mode 100644
index 0000000..e334b0e
--- /dev/null
+++ b/k8s/workloads/broken.yaml
@@ -0,0 +1,57 @@
+# Revision 2: the broken rollouts the agent has to find. RollingUpdate keeps the old revision-1 pod serving.
+# commit e4f5a6b removed DATABASE_URL -> CrashLoopBackOff
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: web
+  labels: {app: web}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy e4f5a6b"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: web}}
+  template:
+    metadata: {labels: {app: web}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: web
+          image: busybox:1.37
+          command: ["sh", "-c", "echo 'Starting web server...'; if [ -z \"$DATABASE_URL\" ]; then echo 'FATAL: environment variable DATABASE_URL is required'; exit 1; fi; sleep 3600"]
+---
+# commit 7f6e5d4 loads everything into memory and cuts the limit -> OOMKilled
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: worker
+  labels: {app: worker}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy 7f6e5d4"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: worker}}
+  template:
+    metadata: {labels: {app: worker}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: worker
+          image: busybox:1.37
+          command: ["sh", "-c", "echo 'Processing batch 1/50 (loading all rows)...'; tail /dev/zero"]
+          resources: {limits: {memory: 32Mi}}
+---
+# a manual `kubectl set image` with a typo'd tag -> ImagePullBackOff
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: api
+  labels: {app: api}
+  annotations: {kubernetes.io/change-cause: "manual: kubectl set image by jdoe"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: api}}
+  template:
+    metadata: {labels: {app: api}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: api
+          image: registry.invalid/api:latestt
