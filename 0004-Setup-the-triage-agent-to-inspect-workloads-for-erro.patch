+# Revision 1 of each workload: healthy. The change-causes reference the commits in main.py's mock GitHub data.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: web
+  labels: {app: web}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy a1b2c3d"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: web}}
+  template:
+    metadata: {labels: {app: web}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: web
+          image: busybox:1.37
+          env: [{name: DATABASE_URL, value: "postgres://web-db:5432/web"}]
+          command: ["sh", "-c", "echo 'Starting web server...'; [ -n \"$DATABASE_URL\" ] || exit 1; echo 'Listening on :8080'; sleep 3600"]
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: worker
+  labels: {app: worker}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy 0c9d8e7"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: worker}}
+  template:
+    metadata: {labels: {app: worker}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: worker
+          image: busybox:1.37
+          command: ["sh", "-c", "echo 'Processing batches (streaming)...'; sleep 3600"]
+          resources: {limits: {memory: 256Mi}}
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: api
+  labels: {app: api}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy 5a4b3c2"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: api}}
+  template:
+    metadata: {labels: {app: api}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: api
+          image: busybox:1.37
+          command: ["sh", "-c", "echo 'GET /healthz 200'; sleep 3600"]
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: cache
+  labels: {app: cache}
+  annotations: {kubernetes.io/change-cause: "github-actions: deploy 9e8d7c6"}
+spec:
+  replicas: 1
+  selector: {matchLabels: {app: cache}}
+  template:
+    metadata: {labels: {app: cache}}
+    spec:
+      terminationGracePeriodSeconds: 1
+      containers:
+        - name: cache
+          image: busybox:1.37
+          command: ["sh", "-c", "echo 'Ready to accept connections'; sleep 3600"]
diff --git a/scripts/cluster-down.sh b/scripts/cluster-down.sh
new file mode 100755
index 0000000..edfba36
--- /dev/null
+++ b/scripts/cluster-down.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Delete the kind cluster created by scripts/cluster-up.sh and its kubeconfig.
+#
+#   scripts/cluster-down.sh
+#   KIND_DEV_CLUSTER_NAME=my-cluster scripts/cluster-down.sh
+set -eu
+cd "$(dirname "$0")/.."
+
+CLUSTER=${KIND_DEV_CLUSTER_NAME:-k8-triage-dev}
+
+kind delete cluster --name "$CLUSTER"
+rm -f .cache/kind-dev.kubeconfig
+echo "Deleted kind cluster $CLUSTER"
diff --git a/scripts/cluster-up.sh b/scripts/cluster-up.sh
new file mode 100755
index 0000000..abe2437
--- /dev/null
+++ b/scripts/cluster-up.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+# Create a kind cluster with the broken workloads the agent has to triage.
+# Recreates the cluster if it already exists. Remove it with scripts/cluster-down.sh.
+#
+#   scripts/cluster-up.sh
+#   KIND_DEV_CLUSTER_NAME=my-cluster scripts/cluster-up.sh
+#
+# Then:
+#   KUBECONFIG=.cache/kind-dev.kubeconfig ./gradlew bootRun --args='--triage.run=true'
+set -eu
+set -x
+cd "$(dirname "$0")/.."
+
+CLUSTER=${KIND_DEV_CLUSTER_NAME:-k8-triage-dev}
+export KUBECONFIG=$PWD/.cache/kind-dev.kubeconfig
+
+for tool in docker kind kubectl; do
+  command -v "$tool" >/dev/null || { echo "error: $tool is not installed" >&2; exit 1; }
+done
+
+echo "==> Creating kind cluster $CLUSTER"
+mkdir -p .cache
+if kind get clusters | grep -qx "$CLUSTER"; then
+  kind delete cluster --name "$CLUSTER"
+fi
+kind create cluster --name "$CLUSTER" --kubeconfig "$KUBECONFIG" --wait 180s
+
+echo "==> Deploying the workloads: revision 1 healthy, then revision 2 broken"
+kubectl apply -f k8s/workloads/healthy.yaml
+kubectl rollout status deployment --timeout=180s
+kubectl apply -f k8s/workloads/broken.yaml
+
+# Wait until each broken workload shows its failure (current or last container state).
+# An OOM kill is sometimes recorded as reason "Error" (containerd misses the OOM event), so exit code 137 counts too.
+states='{range .items[*].status.containerStatuses[*]}{.state.waiting.reason} {.state.terminated.reason} {.lastState.terminated.reason} exit={.lastState.terminated.exitCode} {end}'
+deadline=$(($(date +%s) + 300))
+for expected in "web CrashLoopBackOff" "worker OOMKilled|exit=137" "api ImagePullBackOff|ErrImagePull"; do
+  app=${expected%% *}
+  reason=${expected#* }
+  until kubectl get pods -l "app=$app" -o jsonpath="$states" | grep -qE "$reason"; do
+    if [ "$(date +%s)" -gt "$deadline" ]; then
+      echo "error: $app did not reach $reason" >&2
+      kubectl get pods -l "app=$app" >&2
+      exit 1
+    fi
+    sleep 3
+  done
+  echo "    $app: $reason"
+done
+
+kubectl get deployments,pods
+echo
+echo "Ready. Kubeconfig: $KUBECONFIG"
+echo "  KUBECONFIG=$KUBECONFIG ./gradlew bootRun --args='--triage.run=true'"
