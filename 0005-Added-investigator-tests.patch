@@ -0,0 +1,68 @@
+package com.ebcont.k8.triage;
+
+import io.fabric8.kubernetes.client.KubernetesClient;
+import org.junit.jupiter.api.Tag;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.ArgumentCaptor;
+import org.springframework.ai.chat.client.ChatClient;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * Runs the investigator with a mocked {@link ChatClient} that returns a static answer (investigator-answer.md,
+ * a recorded gpt-oss run) against a new kind cluster per test.
+ */
+@Tag("cluster")
+@ExtendWith(KindClusterExtension.class)
+class InvestigatorAgentIT {
+
+    private final ChatClient.Builder builder = mock(ChatClient.Builder.class);
+    private final ChatClient chatClient = mock(ChatClient.class);
+    private final ChatClient.ChatClientRequestSpec request = mock(ChatClient.ChatClientRequestSpec.class);
+    private final ChatClient.CallResponseSpec response = mock(ChatClient.CallResponseSpec.class);
+
+    @Test
+    void staticAnswerMatchesTheCluster(KubernetesClient client) throws IOException {
+        KubernetesDiagnosticTools tools = new KubernetesDiagnosticTools(client, 200);
+        stubChatClient(staticAnswer());
+
+        String answer = new InvestigatorAgent(builder, tools).investigate(List.of("default"));
+
+        String api = tools.describeDeployment("api", "default");
+        String web = tools.describeDeployment("web", "default");
+        String worker = tools.describeDeployment("worker", "default");
+        assertThat(answer).contains("registry.invalid/api:latestt", "manual: kubectl set image by jdoe");
+        assertThat(api).contains("registry.invalid/api:latestt", "manual: kubectl set image by jdoe");
+        assertThat(answer).contains("github-actions: deploy e4f5a6b", "DATABASE_URL");
+        assertThat(web).contains("github-actions: deploy e4f5a6b");
+        assertThat(answer).contains("github-actions: deploy 7f6e5d4", "memory=32Mi");
+        assertThat(worker).contains("github-actions: deploy 7f6e5d4", "memory=32Mi");
+    }
+
+    private void stubChatClient(String answer) {
+        when(builder.defaultSystem(anyString())).thenReturn(builder);
+        when(builder.defaultTools(any())).thenReturn(builder);
+        when(builder.build()).thenReturn(chatClient);
+        when(chatClient.prompt()).thenReturn(request);
+        when(request.user(anyString())).thenReturn(request);
+        when(request.call()).thenReturn(response);
+        when(response.content()).thenReturn(answer);
+    }
+
+    private static String staticAnswer() throws IOException {
+        try (InputStream in = InvestigatorAgentIT.class.getResourceAsStream("/investigator-answer.md")) {
+            return new String(in.readAllBytes(), StandardCharsets.UTF_8);
+        }
+    }
+}
diff --git a/src/test/java/com/ebcont/k8/triage/KindClusterExtension.java b/src/test/java/com/ebcont/k8/triage/KindClusterExtension.java
new file mode 100644
index 0000000..ab6fb39
--- /dev/null
+++ b/src/test/java/com/ebcont/k8/triage/KindClusterExtension.java
@@ -0,0 +1,74 @@
+package com.ebcont.k8.triage;
+
+import io.fabric8.kubernetes.client.Config;
+import io.fabric8.kubernetes.client.KubernetesClient;
+import io.fabric8.kubernetes.client.KubernetesClientBuilder;
+import org.junit.jupiter.api.extension.AfterEachCallback;
+import org.junit.jupiter.api.extension.BeforeEachCallback;
+import org.junit.jupiter.api.extension.ExtensionContext;
+import org.junit.jupiter.api.extension.ParameterContext;
+import org.junit.jupiter.api.extension.ParameterResolver;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Creates a fresh kind cluster with the broken workloads (scripts/cluster-up.sh) before each test and deletes it
+ * (scripts/cluster-down.sh) afterwards. Tests get a {@link KubernetesClient} for that cluster as a parameter.
+ * Uses its own cluster name and kubeconfig, so the dev cluster from scripts/cluster-up.sh is left alone.
+ * Script output goes to build/kind-test-cluster.log.
+ */
+public class KindClusterExtension implements BeforeEachCallback, AfterEachCallback, ParameterResolver {
+
+    static final String CLUSTER = "k8-triage-test";
+    private static final Path KUBECONFIG = Path.of("build/kind-test.kubeconfig").toAbsolutePath();
+    private static final Path LOG = Path.of("build/kind-test-cluster.log").toAbsolutePath();
+    private static final ExtensionContext.Namespace NAMESPACE = ExtensionContext.Namespace.create(KindClusterExtension.class);
+
+    @Override
+    public void beforeEach(ExtensionContext context) throws Exception {
+        runScript("scripts/cluster-up.sh", 10);
+        KubernetesClient client = new KubernetesClientBuilder()
+                .withConfig(Config.fromKubeconfig(Files.readString(KUBECONFIG)))
+                .build();
+        context.getStore(NAMESPACE).put(KubernetesClient.class, client);
+    }
+
+    @Override
+    public void afterEach(ExtensionContext context) throws Exception {
+        KubernetesClient client = context.getStore(NAMESPACE).remove(KubernetesClient.class, KubernetesClient.class);
+        if (client != null) {
+            client.close();
+        }
+        runScript("scripts/cluster-down.sh", 2);
+    }
+
+    @Override
+    public boolean supportsParameter(ParameterContext parameterContext, ExtensionContext extensionContext) {
+        return parameterContext.getParameter().getType() == KubernetesClient.class;
+    }
+
+    @Override
+    public Object resolveParameter(ParameterContext parameterContext, ExtensionContext extensionContext) {
+        return extensionContext.getStore(NAMESPACE).get(KubernetesClient.class, KubernetesClient.class);
+    }
+
+    private static void runScript(String script, long timeoutMinutes) throws IOException, InterruptedException {
+        Files.createDirectories(LOG.getParent());
+        ProcessBuilder builder = new ProcessBuilder("sh", script)
+                .redirectErrorStream(true)
+                .redirectOutput(ProcessBuilder.Redirect.appendTo(LOG.toFile()));
+        builder.environment().put("KIND_DEV_CLUSTER_NAME", CLUSTER);
+        builder.environment().put("KIND_DEV_KUBECONFIG", KUBECONFIG.toString());
+        Process process = builder.start();
+        if (!process.waitFor(timeoutMinutes, TimeUnit.MINUTES)) {
+            process.destroyForcibly();
+            throw new IllegalStateException(script + " timed out after " + timeoutMinutes + " min, see " + LOG);
+        }
+        if (process.exitValue() != 0) {
+            throw new IllegalStateException(script + " failed with exit code " + process.exitValue() + ", see " + LOG);
+        }
+    }
+}
