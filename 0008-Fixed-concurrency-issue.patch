new file mode 100644
index 0000000..53e4adc
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/AiConfig.java
@@ -0,0 +1,53 @@
+package com.ebcont.k8.triage;
+
+import org.springframework.ai.chat.memory.ChatMemory;
+import org.springframework.ai.chat.memory.InMemoryChatMemoryRepository;
+import org.springframework.ai.chat.memory.MessageWindowChatMemory;
+import org.springframework.ai.chat.messages.AssistantMessage;
+import org.springframework.ai.chat.messages.Message;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.util.StringUtils;
+
+import java.util.List;
+
+@Configuration
+public class AiConfig {
+
+    /**
+     * Holds each investigation as its own conversation, including every tool call and result. The window must fit a
+     * whole investigation (two messages per tool round): older messages are dropped silently.
+     */
+    @Bean
+    ChatMemory chatMemory() {
+        return new SkipEmptyAssistantMessages(MessageWindowChatMemory.builder()
+                .chatMemoryRepository(new InMemoryChatMemoryRepository())
+                .maxMessages(500)
+                .build());
+    }
+
+    /**
+     * Bedrock returns a reasoning model's (gpt-oss) reasoning as an extra generation without text or tool calls. The
+     * memory advisor stores every generation, and Bedrock rejects such an empty message when it is sent back
+     * ("The content field in the Message object ... is empty"), so it is not stored.
+     */
+    record SkipEmptyAssistantMessages(ChatMemory delegate) implements ChatMemory {
+
+        @Override
+        public void add(String conversationId, List<Message> messages) {
+            delegate.add(conversationId, messages.stream()
+                    .filter(m -> !(m instanceof AssistantMessage a && !a.hasToolCalls() && !StringUtils.hasText(a.getText())))
+                    .toList());
+        }
+
+        @Override
+        public List<Message> get(String conversationId) {
+            return delegate.get(conversationId);
+        }
+
+        @Override
+        public void clear(String conversationId) {
+            delegate.clear(conversationId);
+        }
+    }
+}
