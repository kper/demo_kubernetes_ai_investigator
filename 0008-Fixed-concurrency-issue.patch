 package com.ebcont.k8.triage;
 
 import org.springframework.ai.chat.client.ChatClient;
+import org.springframework.ai.chat.client.advisor.MessageChatMemoryAdvisor;
+import org.springframework.ai.chat.client.advisor.ToolCallingAdvisor;
+import org.springframework.ai.chat.memory.ChatMemory;
+import org.springframework.ai.chat.messages.AssistantMessage;
+import org.springframework.ai.chat.messages.Message;
+import org.springframework.ai.chat.messages.ToolResponseMessage;
 import org.springframework.stereotype.Component;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.type.TypeReference;
+import tools.jackson.databind.json.JsonMapper;
 
+import java.util.ArrayList;
+import java.util.HashMap;
 import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
 
 @Component
 public class InvestigatorAgent {
 
+    /**
+     * The investigator's answer and every tool call it made with its output, for the root cause agent: the
+     * investigator only summarises, so the evidence lives in the tool results.
+     */
+    public record Investigation(String answer, List<String> evidence) {
+    }
+
     private final ChatClient chatClient;
+    private final ChatMemory chatMemory;
 
-    public InvestigatorAgent(ChatClient.Builder builder, KubernetesDiagnosticTools diagnosticTools) {
+    public InvestigatorAgent(ChatClient.Builder builder, KubernetesDiagnosticTools diagnosticTools, ChatMemory chatMemory) {
+        this.chatMemory = chatMemory;
         this.chatClient = builder
                 .defaultSystem(KubernetesDiagnosticTools.INVESTIGATOR_PROMPT)
                 .defaultTools(diagnosticTools)
+                .defaultAdvisors(MessageChatMemoryAdvisor.builder(chatMemory)
+                        .order(ToolCallingAdvisor.DEFAULT_ORDER + 1)
+                        .build())
                 .build();
     }
 
-    public String investigate(List<String> namespaces) {
-        return chatClient.prompt()
-                .user("Investigate the workloads in these Kubernetes namespaces: " + String.join(", ", namespaces))
-                .call()
-                .content();
+    /**
+     * Investigates the namespaces as conversation {@code conversationId}, which must be unique per investigation, and
+     * returns the evidence from it. The conversation is removed from the chat memory afterwards.
+     */
+    public Investigation investigate(String conversationId, List<String> namespaces) {
+        chatMemory.clear(conversationId);
+        try {
+            String answer = chatClient.prompt()
+                    .user("Investigate the workloads in these Kubernetes namespaces: " + String.join(", ", namespaces))
+                    .advisors(a -> a.param(ChatMemory.CONVERSATION_ID, conversationId))
+                    .call()
+                    .content();
+            return new Investigation(answer, evidence(chatMemory.get(conversationId)));
+        } finally {
+            chatMemory.clear(conversationId);
+        }
+    }
+
+    /** Every tool call in the conversation with its arguments and result. */
+    private static List<String> evidence(List<Message> conversation) {
+        Map<String, AssistantMessage.ToolCall> toolCalls = new HashMap<>();
+        List<String> evidence = new ArrayList<>();
+        for (Message message : conversation) {
+            if (message instanceof AssistantMessage assistant) {
+                assistant.getToolCalls().forEach(call -> toolCalls.put(call.id(), call));
+            } else if (message instanceof ToolResponseMessage toolResponses) {
+                for (ToolResponseMessage.ToolResponse response : toolResponses.getResponses()) {
+                    AssistantMessage.ToolCall call = toolCalls.get(response.id());
+                    String arguments = call == null ? "" : arguments(call.arguments());
+                    evidence.add("### " + response.name() + "(" + arguments + ")\n" + toolResult(response.responseData()));
+                }
+            }
+        }
+        return evidence;
+    }
+
+    /**
+     * Tool arguments as {@code namespace=default, id=api-1}: without JSON quotes, which the root cause agent would
+     * have to escape when it quotes the evidence in its JSON report.
+     */
+    private static String arguments(String json) {
+        try {
+            return JsonMapper.shared().readValue(json, new TypeReference<Map<String, Object>>() {
+            }).entrySet().stream()
+                    .map(e -> e.getKey() + "=" + e.getValue())
+                    .collect(Collectors.joining(", "));
+        } catch (JacksonException e) {
+            return json;
+        }
+    }
+
+    /** Spring AI stores a tool's String result JSON-encoded; decode it back to the text the tool returned. */
+    private static String toolResult(String responseData) {
+        try {
+            return JsonMapper.shared().readValue(responseData, String.class);
+        } catch (JacksonException e) {
+            return responseData;
+        }
     }
 }
