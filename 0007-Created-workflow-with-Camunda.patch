+++ b/src/main/java/com/ebcont/k8/triage/RollbackTools.java
@@ -0,0 +1,81 @@
+package com.ebcont.k8.triage;
+
+import io.fabric8.kubernetes.api.model.PodTemplateSpec;
+import io.fabric8.kubernetes.api.model.PodTemplateSpecBuilder;
+import io.fabric8.kubernetes.api.model.apps.Deployment;
+import io.fabric8.kubernetes.api.model.apps.DeploymentBuilder;
+import io.fabric8.kubernetes.api.model.apps.ReplicaSet;
+import io.fabric8.kubernetes.client.KubernetesClient;
+import io.fabric8.kubernetes.client.KubernetesClientException;
+import org.springframework.ai.tool.annotation.Tool;
+import org.springframework.ai.tool.annotation.ToolParam;
+import org.springframework.stereotype.Component;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+
+@Component
+public class RollbackTools {
+
+    private static final String REVISION_ANNOTATION = "deployment.kubernetes.io/revision";
+    private static final String CHANGE_CAUSE_ANNOTATION = "kubernetes.io/change-cause";
+    private static final String POD_TEMPLATE_HASH_LABEL = "pod-template-hash";
+
+    private final KubernetesClient client;
+
+    public RollbackTools(KubernetesClient client) {
+        this.client = client;
+    }
+
+    @Tool(description = "Roll back a deployment to a revision from its rollout history (like `kubectl rollout undo --to-revision`).")
+    public String rollbackDeployment(@ToolParam(description = "Deployment name") String deployment,
+                                     @ToolParam(description = "Namespace of the deployment") String namespace,
+                                     @ToolParam(description = "Revision from the rollout history to roll back to") int toRevision) {
+        try {
+            Deployment current = client.apps().deployments().inNamespace(namespace).withName(deployment).get();
+            if (current == null) {
+                return "Error: Deployment " + namespace + "/" + deployment + " not found.";
+            }
+            Optional<ReplicaSet> target = replicaSet(current, toRevision);
+            if (target.isEmpty()) {
+                return "Error: revision " + toRevision + " of deployment " + namespace + "/" + deployment
+                        + " not found in its rollout history.";
+            }
+
+            // Like kubectl rollout undo: restore the revision's pod template, without the label the controller adds.
+            PodTemplateSpec template = new PodTemplateSpecBuilder(target.get().getSpec().getTemplate()).build();
+            Map<String, String> labels = new HashMap<>(template.getMetadata().getLabels());
+            labels.remove(POD_TEMPLATE_HASH_LABEL);
+            template.getMetadata().setLabels(labels);
+
+            client.apps().deployments().inNamespace(namespace).withName(deployment).edit(d -> new DeploymentBuilder(d)
+                    .editMetadata()
+                        .addToAnnotations(CHANGE_CAUSE_ANNOTATION, "triage: rollback to revision " + toRevision + " (approved)")
+                    .endMetadata()
+                    .editSpec()
+                        .withTemplate(template)
+                    .endSpec()
+                    .build());
+            return "Rolled back deployment " + namespace + "/" + deployment + " to revision " + toRevision + ".";
+        } catch (KubernetesClientException e) {
+            return "Error: Kubernetes API call failed (HTTP " + e.getCode() + "): " + e.getMessage();
+        } catch (RuntimeException e) {
+            return "Error: " + e.getMessage();
+        }
+    }
+
+    private Optional<ReplicaSet> replicaSet(Deployment deployment, int revision) {
+        String uid = deployment.getMetadata().getUid();
+        return client.apps().replicaSets().inNamespace(deployment.getMetadata().getNamespace()).list().getItems().stream()
+                .filter(rs -> rs.getMetadata().getOwnerReferences() != null
+                        && rs.getMetadata().getOwnerReferences().stream().anyMatch(o -> uid.equals(o.getUid())))
+                .filter(rs -> String.valueOf(revision).equals(annotation(rs, REVISION_ANNOTATION)))
+                .findFirst();
+    }
+
+    private static String annotation(ReplicaSet rs, String name) {
+        Map<String, String> annotations = rs.getMetadata().getAnnotations();
+        return annotations == null ? null : annotations.get(name);
+    }
+}
