diff --git a/src/main/java/com/ebcont/k8/triage/TriageWorkers.java b/src/main/java/com/ebcont/k8/triage/TriageWorkers.java
new file mode 100644
index 0000000..c3af13f
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/TriageWorkers.java
@@ -0,0 +1,86 @@
+package com.ebcont.k8.triage;
+
+import io.camunda.client.annotation.JobWorker;
+import io.camunda.client.annotation.Variable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.stereotype.Component;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/** Job workers for the service tasks of the k8-triage process (src/main/resources/bpmn/k8-triage.bpmn). */
+@Component
+@ConditionalOnProperty(name = "triage.run", havingValue = "true")
+public class TriageWorkers {
+
+    private static final Logger log = LoggerFactory.getLogger(TriageWorkers.class);
+    private static final long LLM_TIMEOUT_MS = 10 * 60 * 1000;
+
+    private final InvestigatorAgent investigator;
+    private final RootCauseAgent rootCause;
+    private final KubernetesDiagnosticTools diagnosticTools;
+    private final RollbackTools rollbackTools;
+
+    public TriageWorkers(InvestigatorAgent investigator, RootCauseAgent rootCause,
+                         KubernetesDiagnosticTools diagnosticTools, RollbackTools rollbackTools) {
+        this.investigator = investigator;
+        this.rootCause = rootCause;
+        this.diagnosticTools = diagnosticTools;
+        this.rollbackTools = rollbackTools;
+    }
+
+    @JobWorker(type = "investigate", timeout = LLM_TIMEOUT_MS, fetchVariables = "namespaces")
+    public Map<String, Object> investigate(@Variable("namespaces") List<String> namespaces) {
+        log.info("Starting investigation of namespaces {}", namespaces);
+        diagnosticTools.clearEvidence();
+        String answer = investigator.investigate(namespaces);
+        log.info("Investigator: {}", answer);
+        return Map.of("investigationEvidence", diagnosticTools.evidence(), "investigationAnswer", answer);
+    }
+
+    @JobWorker(type = "analyse-root-cause", timeout = LLM_TIMEOUT_MS,
+            fetchVariables = {"investigationEvidence", "investigationAnswer"})
+    public Map<String, Object> analyse(@Variable("investigationEvidence") List<String> evidence,
+                                       @Variable("investigationAnswer") String answer) {
+        log.info("Running root cause analysis on {} tool results", evidence.size());
+        RootCauseReport report = rootCause.analyse(evidence, answer);
+        report.findings().forEach(TriageWorkers::logFinding);
+        List<RollbackProposal> rollbacks = report.findings().stream()
+                .map(RollbackProposal::of)
+                .filter(Objects::nonNull)
+                .toList();
+        log.info("{} rollback(s) waiting for approval in Tasklist: http://localhost:8080/tasklist", rollbacks.size());
+        return Map.of("report", report, "rollbacks", rollbacks);
+    }
+
+    @JobWorker(type = "rollback-deployment", fetchVariables = {"rollback", "comment"})
+    public Map<String, Object> rollback(@Variable("rollback") RollbackProposal rollback, @Variable("comment") String comment) {
+        log.info("Rollback of {} approved{}", rollback.key(), comment == null || comment.isBlank() ? "" : ": " + comment);
+        String result = rollbackTools.rollbackDeployment(rollback.deployment(), rollback.namespace(), rollback.toRevision());
+        if (result.startsWith("Error:")) {
+            // Fails the job; with retries=1 this becomes an incident in Operate.
+            throw new IllegalStateException(result);
+        }
+        log.info(result);
+        return Map.of("rollbackResult", result);
+    }
+
+    private static void logFinding(RootCauseReport.Finding finding) {
+        String command = RootCauseReport.rollbackCommand(finding);
+        String reason = finding.rollback() == null ? "" : " (" + finding.rollback().reason() + ")";
+        log.info("""
+                        {}/{}
+                          Symptom:    {}
+                          Root cause: {}
+                          Change:     {}
+                          Evidence:   {}
+                          Fix:        {}
+                          Rollback:   {}""",
+                finding.namespace(), finding.deployment(), finding.symptom(), finding.rootCause(),
+                finding.offendingChange(), finding.evidence(), finding.fix(),
+                (command != null ? "proposed: " + command : "not recommended") + reason);
+    }
+}
