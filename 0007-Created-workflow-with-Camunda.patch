diff --git a/scripts/camunda-up.sh b/scripts/camunda-up.sh
new file mode 100755
index 0000000..e5e3695
--- /dev/null
+++ b/scripts/camunda-up.sh
@@ -0,0 +1,41 @@
+#!/bin/sh
+# Start a local Camunda 8 (Zeebe, Operate, Tasklist) in one Docker container, with in-memory H2 storage.
+# Replaces the container if it already exists. Remove it with scripts/camunda-down.sh.
+#
+#   scripts/camunda-up.sh
+#
+# Then: Tasklist http://localhost:8080/tasklist and Operate http://localhost:8080/operate (login demo/demo).
+# Everything is lost when the container stops.
+set -eu
+
+CONTAINER=camunda-dev
+
+command -v docker >/dev/null || { echo "error: docker is not installed" >&2; exit 1; }
+
+docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
+docker run -d --name "$CONTAINER" -p 8080:8080 -p 26500:26500 -p 9600:9600 \
+  -e CAMUNDA_DATA_SECONDARYSTORAGE_TYPE=rdbms \
+  -e CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_URL='jdbc:h2:mem:camunda;DB_CLOSE_DELAY=-1;MODE=PostgreSQL' \
+  -e CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_USERNAME=sa \
+  -e CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_PASSWORD= \
+  -e CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI=true \
+  -e CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED=false \
+  -e CAMUNDA_SECURITY_INITIALIZATION_USERS_0_USERNAME=demo \
+  -e CAMUNDA_SECURITY_INITIALIZATION_USERS_0_PASSWORD=demo \
+  -e CAMUNDA_SECURITY_INITIALIZATION_USERS_0_NAME=Demo \
+  -e CAMUNDA_SECURITY_INITIALIZATION_USERS_0_EMAIL=demo@example.com \
+  -e CAMUNDA_SECURITY_INITIALIZATION_DEFAULTROLES_ADMIN_USERS_0=demo \
+  camunda/camunda:8.9.21
+
+echo "==> Waiting for Camunda (about a minute)"
+deadline=$(($(date +%s) + 180))
+until curl -fs http://localhost:9600/actuator/health/status >/dev/null 2>&1 \
+    && curl -fs http://localhost:8080/v2/topology >/dev/null 2>&1; do
+  if [ "$(date +%s)" -gt "$deadline" ]; then
+    echo "error: Camunda did not become healthy" >&2
+    docker logs --tail 50 "$CONTAINER" >&2
+    exit 1
+  fi
+  sleep 3
+done
+echo "Ready. Tasklist http://localhost:8080/tasklist, Operate http://localhost:8080/operate (demo/demo)"
diff --git a/src/main/java/com/ebcont/k8/triage/RollbackProposal.java b/src/main/java/com/ebcont/k8/triage/RollbackProposal.java
