diff --git a/src/main/java/com/ebcont/k8/triage/FixAgent.java b/src/main/java/com/ebcont/k8/triage/FixAgent.java
new file mode 100644
index 0000000..abe7d48
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/FixAgent.java
@@ -0,0 +1,102 @@
+package com.ebcont.k8.triage;
+
+import org.springframework.ai.chat.client.ChatClient;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.http.HttpClient;
+import java.time.Duration;
+import java.util.List;
+import java.util.Objects;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Proposes a code fix for a finding in the deployment's source repository, as Markdown with a unified diff. The
+ * repository's source is fetched from GitHub up front and sent with the request: the model gets no tools.
+ */
+@Component
+public class FixAgent {
+
+    static final String FIX_PROMPT = """
+            You are the engineer who owns this repository. A Kubernetes triage found a problem in a workload built from
+            it. Propose a fix in its source code. The message contains the repository's file list and the content of
+            its source files; base your change only on that content.
+            Make the smallest change that removes the root cause, not just its symptom. Do not hide errors or remove
+            logging or metrics. Keep the code's style, and add or adjust tests if the repository has them.
+            If the problem is only configuration (e.g. environment variables of the deployment), say so and propose
+            that change instead of a code change.
+            Reply in Markdown with exactly these sections:
+            ## Summary
+            ## Why this fixes the root cause
+            ## Change
+            One ```diff block with a unified diff against the files in the message, with paths from the repository
+            root (a/... and b/...), that applies with `git apply`.
+            ## Configuration
+            Changes to the deployment or its environment, or "None".
+            ## Verification
+            ## Risks
+            """;
+
+    /** Not sent: lock files, binaries and vendored or generated files don't help to write a fix. */
+    private static final Pattern SKIPPED = Pattern.compile(
+            "(?i).*(\\.lock|lock\\.json|\\.(png|jpe?g|gif|ico|svg|pdf|zip|gz|jar|class|so|dll|exe|bin))$|(^|/)(vendor|node_modules|target|dist|build)/.*");
+    private static final long MAX_FILE_BYTES = 50 * 1024;
+    private static final long MAX_TOTAL_BYTES = 200 * 1024;
+
+    private final ChatClient chatClient;
+    private final HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10))
+            .followRedirects(HttpClient.Redirect.NORMAL).build();
+    private final String githubToken;
+
+    public FixAgent(ChatClient.Builder builder, @Value("${triage.github.token:}") String githubToken) {
+        this.chatClient = builder.defaultSystem(FIX_PROMPT).build();
+        this.githubToken = githubToken;
+    }
+
+    public String propose(FixCandidate fix) {
+        String answer = chatClient.prompt()
+                .user("""
+                        Repository: %s (ref %s)
+                        Workload: deployment %s
+
+                        Symptom: %s
+                        Root cause: %s
+                        Fix suggested by the root cause analysis: %s
+
+                        %s""".formatted(fix.repository(), fix.ref(), fix.key(), fix.symptom(), fix.rootCause(),
+                        fix.suggestedFix(), source(new GitHubRepository(fix.sourceRepository(), http, githubToken))))
+                .call()
+                .content();
+        // gpt-oss sometimes ends with reasoning only and no text.
+        return Objects.requireNonNullElse(answer, "(no proposal: the model returned no text)");
+    }
+
+    /** The repository's file list and the content of its source files, as Markdown. */
+    static String source(GitHubRepository repository) {
+        try {
+            List<GitHubRepository.File> files = repository.files();
+            StringBuilder sb = new StringBuilder("## Files\n\n")
+                    .append(files.stream().map(f -> f.path() + "  " + f.size() + " bytes").collect(Collectors.joining("\n")))
+                    .append("\n\n## Source\n");
+            long total = 0;
+            for (GitHubRepository.File file : files) {
+                if (SKIPPED.matcher(file.path()).matches() || file.size() > MAX_FILE_BYTES) {
+                    continue;
+                }
+                if (total + file.size() > MAX_TOTAL_BYTES) {
+                    sb.append("\n(further files left out: size limit)\n");
+                    break;
+                }
+                total += file.size();
+                sb.append("\n### ").append(file.path()).append("\n````\n").append(repository.read(file.path()))
+                        .append("\n````\n");
+            }
+            return sb.toString();
+        } catch (IOException e) {
+            throw new UncheckedIOException("Reading the source repository failed", e);
+        }
+    }
+}
