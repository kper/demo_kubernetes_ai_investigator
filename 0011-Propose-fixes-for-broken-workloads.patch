+{
+  "id": "review-fix",
+  "type": "default",
+  "executionPlatform": "Camunda Cloud",
+  "executionPlatformVersion": "8.9.0",
+  "schemaVersion": 18,
+  "components": [
+    {
+      "id": "Text_Finding",
+      "type": "text",
+      "text": "# Fix for {{fix.key}}\n\n**Repository:** {{fix.repository}} (ref {{fix.ref}})\n\n**Symptom:** {{fix.symptom}}\n\n**Root cause:** {{fix.rootCause}}"
+    },
+    {
+      "id": "Text_Proposal",
+      "type": "text",
+      "text": "{{fixProposal}}"
+    },
+    {
+      "id": "Radio_Decision",
+      "type": "radio",
+      "key": "decision",
+      "label": "Decision",
+      "validate": { "required": true },
+      "values": [
+        { "label": "Accept the fix (pull requests are not created yet)", "value": "accept" },
+        { "label": "Reject", "value": "reject" }
+      ]
+    },
+    {
+      "id": "Textarea_Comment",
+      "type": "textarea",
+      "key": "comment",
+      "label": "Comment"
+    }
+  ]
+}
