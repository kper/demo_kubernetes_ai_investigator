@@ -0,0 +1,19 @@
+package com.ebcont.k8.triage;
+
+/**
+ * A finding whose deployment has a source repository, as process variable {@code fix} of one "Propose fix" subprocess.
+ * {@code key} is "namespace/deployment".
+ */
+public record FixCandidate(String key, String namespace, String deployment, String repository, String owner,
+                           String name, String ref, String symptom, String rootCause, String suggestedFix) {
+
+    static FixCandidate of(RootCauseReport.Finding finding, SourceRepositories.Repository repository) {
+        return new FixCandidate(finding.namespace() + "/" + finding.deployment(), finding.namespace(),
+                finding.deployment(), repository.url(), repository.owner(), repository.name(), repository.ref(),
+                finding.symptom(), finding.rootCause(), finding.fix());
+    }
+
+    SourceRepositories.Repository sourceRepository() {
+        return new SourceRepositories.Repository(repository, owner, name, ref);
+    }
+}
diff --git a/src/main/java/com/ebcont/k8/triage/GitHubRepository.java b/src/main/java/com/ebcont/k8/triage/GitHubRepository.java
new file mode 100644
index 0000000..b3edbcf
--- /dev/null
+++ b/src/main/java/com/ebcont/k8/triage/GitHubRepository.java
@@ -0,0 +1,67 @@
+package com.ebcont.k8.triage;
+
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.List;
+import java.util.stream.StreamSupport;
+
+/**
+ * Reads one GitHub repository for the {@link FixAgent}: its file list and file contents. Public repositories need no
+ * token (60 requests/hour).
+ */
+public class GitHubRepository {
+
+    public record File(String path, long size) {
+    }
+
+    private static final Duration TIMEOUT = Duration.ofSeconds(30);
+
+    private final SourceRepositories.Repository repository;
+    private final HttpClient http;
+    private final String token;
+
+    public GitHubRepository(SourceRepositories.Repository repository, HttpClient http, String token) {
+        this.repository = repository;
+        this.http = http;
+        this.token = token;
+    }
+
+    /** Every file in the repository, with its size in bytes. */
+    public List<File> files() throws IOException {
+        JsonNode tree = JsonMapper.shared().readTree(get("https://api.github.com/repos/" + repository.owner() + "/"
+                + repository.name() + "/git/trees/" + repository.ref() + "?recursive=1"));
+        return StreamSupport.stream(tree.path("tree").spliterator(), false)
+                .filter(entry -> "blob".equals(entry.path("type").asString()))
+                .map(entry -> new File(entry.path("path").asString(), entry.path("size").asLong()))
+                .toList();
+    }
+
+    public String read(String path) throws IOException {
+        return get("https://raw.githubusercontent.com/" + repository.owner() + "/" + repository.name() + "/"
+                + repository.ref() + "/" + path);
+    }
+
+    private String get(String url) throws IOException {
+        HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(url)).timeout(TIMEOUT).GET();
+        if (token != null && !token.isBlank()) {
+            request.header("Authorization", "Bearer " + token);
+        }
+        try {
+            HttpResponse<String> response = http.send(request.build(), HttpResponse.BodyHandlers.ofString());
+            if (response.statusCode() != 200) {
+                throw new IOException("GET " + url + " returned HTTP " + response.statusCode());
+            }
+            return response.body();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("interrupted", e);
+        }
+    }
+}
