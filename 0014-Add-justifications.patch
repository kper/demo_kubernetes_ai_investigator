 package com.ebcont.k8.triage;
 
+import io.fabric8.kubernetes.api.model.Container;
 import io.fabric8.kubernetes.api.model.PodTemplateSpec;
 import io.fabric8.kubernetes.api.model.PodTemplateSpecBuilder;
 import io.fabric8.kubernetes.api.model.apps.Deployment;
@@ -11,7 +12,11 @@ import org.springframework.ai.tool.annotation.Tool;
 import org.springframework.ai.tool.annotation.ToolParam;
 import org.springframework.stereotype.Component;
 
+import java.util.Comparator;
 import java.util.HashMap;
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Collectors;
 import java.util.Map;
 import java.util.Optional;
 
@@ -65,13 +70,42 @@ public class RollbackTools {
         }
     }
 
+    /**
+     * The revisions a rollback to {@code toRevision} would undo: every later one up to the current, with its images and
+     * change-cause, read from the cluster (not from the model). Empty if the deployment doesn't exist.
+     */
+    public List<String> revisionsAfter(String namespace, String deployment, int toRevision) {
+        Deployment current = client.apps().deployments().inNamespace(namespace).withName(deployment).get();
+        if (current == null) {
+            return List.of();
+        }
+        return ownedReplicaSets(current).stream()
+                .filter(rs -> revision(rs) > toRevision)
+                .sorted(Comparator.comparingLong(RollbackTools::revision))
+                .map(rs -> "revision " + revision(rs) + ": " + rs.getSpec().getTemplate().getSpec().getContainers().stream()
+                        .map(Container::getImage).collect(Collectors.joining(", "))
+                        + ", change-cause: " + Objects.requireNonNullElse(annotation(rs, CHANGE_CAUSE_ANNOTATION), "<none>"))
+                .toList();
+    }
+
     private Optional<ReplicaSet> replicaSet(Deployment deployment, int revision) {
+        return ownedReplicaSets(deployment).stream().filter(rs -> revision(rs) == revision).findFirst();
+    }
+
+    private List<ReplicaSet> ownedReplicaSets(Deployment deployment) {
         String uid = deployment.getMetadata().getUid();
         return client.apps().replicaSets().inNamespace(deployment.getMetadata().getNamespace()).list().getItems().stream()
                 .filter(rs -> rs.getMetadata().getOwnerReferences() != null
                         && rs.getMetadata().getOwnerReferences().stream().anyMatch(o -> uid.equals(o.getUid())))
-                .filter(rs -> String.valueOf(revision).equals(annotation(rs, REVISION_ANNOTATION)))
-                .findFirst();
+                .toList();
+    }
+
+    private static long revision(ReplicaSet rs) {
+        try {
+            return Long.parseLong(Objects.requireNonNullElse(annotation(rs, REVISION_ANNOTATION), "0"));
+        } catch (NumberFormatException e) {
+            return 0;
+        }
     }
 
     private static String annotation(ReplicaSet rs, String name) {
