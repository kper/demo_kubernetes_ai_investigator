diff --git a/src/main/java/com/ebcont/k8/triage/RollbackProposal.java b/src/main/java/com/ebcont/k8/triage/RollbackProposal.java
index b9682e1..4ab2110 100644
--- a/src/main/java/com/ebcont/k8/triage/RollbackProposal.java
+++ b/src/main/java/com/ebcont/k8/triage/RollbackProposal.java
@@ -1,20 +1,32 @@
 package com.ebcont.k8.triage;
 
+import java.util.List;
+import java.util.stream.Collectors;
+
 /**
  * A rollback the root cause agent proposed, as process variable {@code rollback} of one "Approve rollback" user task.
- * {@code key} is "namespace/deployment".
+ * {@code key} is "namespace/deployment". The list fields are Markdown for the approval form: {@code undoes} comes from
+ * the cluster, {@code justification}, {@code undoneRevisions} and {@code suspiciousContent} from the agent.
  */
 public record RollbackProposal(String key, String namespace, String deployment, int toRevision, String command,
-                               String reason, String symptom, String rootCause) {
+                               String reason, String symptom, String rootCause, String undoes, String justification,
+                               String undoneRevisions, String suspiciousContent) {
 
-    /** The proposal for a finding with a recommended rollback, or null. */
-    static RollbackProposal of(RootCauseReport.Finding finding) {
+    /** The proposal for a finding with a recommended rollback, or null. {@code undoes}: from RollbackTools.revisionsAfter. */
+    static RollbackProposal of(RootCauseReport.Finding finding, List<String> undoes) {
         String command = RootCauseReport.rollbackCommand(finding);
         if (command == null) {
             return null;
         }
+        RootCauseReport.RollbackProposal rollback = finding.rollback();
         return new RollbackProposal(finding.namespace() + "/" + finding.deployment(), finding.namespace(),
-                finding.deployment(), finding.rollback().toRevision(), command, finding.rollback().reason(),
-                finding.symptom(), finding.rootCause());
+                finding.deployment(), rollback.toRevision(), command, rollback.reason(), finding.symptom(),
+                finding.rootCause(), markdownList(undoes), markdownList(rollback.justification()),
+                rollback.undoneRevisions(), markdownList(finding.suspiciousContent()));
+    }
+
+    private static String markdownList(List<String> items) {
+        return items == null || items.isEmpty() ? "none"
+                : items.stream().map(item -> "- " + item.replace("\n", " ")).collect(Collectors.joining("\n"));
     }
 }
